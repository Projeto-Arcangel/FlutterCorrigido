# Segredos das Edge Functions (LOCAL). Copie para `.env` (gitignored) e preencha.
# Uso local:  npx supabase functions serve generate-questions --env-file supabase/functions/.env
# Cloud:      npx supabase secrets set OPENROUTER_API_KEY=sk-or-...

OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Leitura de vídeos do YouTube (extract-video).
GEMINI_API_KEY=

# Pagamentos (Asaas). Sem ASAAS_API_KEY o pagamento pelo app fica desligado
# (as funções billing-* respondem "em breve"). Produção:
# ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
